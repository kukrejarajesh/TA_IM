ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# TA_PROVIDER=anthropic
# TA_QUICK_MODEL=claude-haiku-5-5
# TA_DEEP_MODEL=claude-sonnet-5-5
# TA_DEBATE_ROUNDS=1         # 0 to 3 (0 = no bull/bear debate)
# TA_RISK_ROUNDS=1           # 0 to 3 (0 = no risk debate)
# TA_TEMPERATURE=0.0
# TA_BUDGET_USD=1.0
# TA_MIN_NEWS_ITEMS=3         # fewer news items than this: the report is flagged insufficient_data
# TA_CACHE_MODE=off          # off | record | replay
# TA_CACHE_DIR=.llm_cache
# TA_TRACE_DIR=traces
# TA_DATA_CACHE_DIR=.data_cache
# Zerodha Kite Connect (market data only). The access token expires daily.
# TA_KITE_API_KEY=
# TA_KITE_ACCESS_TOKEN=
# Currents API (dated market news). Free tier is rate limited.
# CURRENTS_API_KEY=
